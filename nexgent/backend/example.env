NC_URL=https://nextcloud.example.com
NC_USER=your-nextcloud-username
NC_PASS=your-nextcloud-app-password
NC_VERIFY_SSL=true
# Optional: trust a private/self-signed CA without disabling SSL verification.
# NC_CA_BUNDLE=/path/to/nextcloud-ca.pem
NC_TIMEOUT_SECONDS=30
# Optional comma-separated browser origins outside Docker development.
# NEXGENT_CORS_ORIGINS=http://localhost:5173
# Optional regex alternative; overrides the frontend-port rule used by Compose.
# NEXGENT_CORS_ORIGIN_REGEX=^https?://[^/]+:5173$

# Private Agent Server used by POST /api/chat/stream.
AX_AGENT_SERVER_URL=http://agent-server:2024
AX_CHAT_ASSISTANT_ID=chat
# Backend and Agent Server must mount the same private volume at this path.
AX_CHAT_ARTIFACT_ROOT=/run/ax-chat
# Crash-recovery cleanup threshold. Cleanup runs when the backend starts.
AX_CHAT_STALE_AFTER_SECONDS=900
AX_AGENT_SERVER_CONNECT_TIMEOUT_SECONDS=5
AX_AGENT_SERVER_WRITE_TIMEOUT_SECONDS=30
