NC_URL=https://nextcloud.example.com
NC_USER=your-nextcloud-username
NC_PASS=your-nextcloud-app-password
NC_VERIFY_SSL=true
# Optional: trust a private/self-signed CA without disabling SSL verification.
# NC_CA_BUNDLE=/path/to/nextcloud-ca.pem
NC_TIMEOUT_SECONDS=30

# Required for the whole Nexgent app. Use an existing PostgreSQL database only.
NEXGENT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/DB_NAME
# Must exactly match the browser origin (including port).
NEXGENT_PUBLIC_URL=http://localhost:5173
# Generate with: python3 backend/setup_env.py
NEXGENT_AUTH_SIGNING_KEY=
# Explicit development-only HTTP opt-in; use HTTPS and false for public deployment.
NEXGENT_ALLOW_INSECURE_HTTP=true
NEXGENT_LOGIN_SECONDS=28800

# Private upstreams, accessed through the authenticated backend.
AX_SCOUT_URL=http://scout:8091
AX_SCOUT_SCHEDULER_URL=http://host.docker.internal:8092
AX_RAG_SERVER_URL=http://host.docker.internal:8765
AX_WEEKLY_REPORT_BULK_URL=http://weekly-report-bulk-api:8090

# Private Agent Server used by POST /api/chat/stream.
AX_AGENT_SERVER_URL=http://agent-server:2024
AX_CHAT_ASSISTANT_ID=chat
# Backend and Agent Server must mount the same private volume at this path.
AX_CHAT_ARTIFACT_ROOT=/run/ax-chat
# Crash-recovery cleanup threshold. Cleanup runs when the backend starts.
AX_CHAT_STALE_AFTER_SECONDS=900
# Keep distinct between deployments sharing the account database.
AX_CHAT_DEPLOYMENT=development
# Private persistent volume shared only by backend and chat worker.
AX_CHAT_FILE_ROOT=/var/lib/nexgent/chat-files
AX_CHAT_WORKER_CONCURRENCY=4
AX_CHAT_RUN_TIMEOUT_SECONDS=300
AX_AGENT_SERVER_CONNECT_TIMEOUT_SECONDS=5
AX_AGENT_SERVER_WRITE_TIMEOUT_SECONDS=30

# Optional Slack notification API and independent delivery worker.
# Disabled until you supply the bot token and destination alias -> channel ID map.
NEXGENT_SLACK_ENABLED=false
NEXGENT_SLACK_BOT_TOKEN=
NEXGENT_SLACK_CHANNELS='{"default":"C0123456789","alerts":"C0987654321"}'
# Optional machine-to-machine Bearer token (32+ random characters); never put in frontend code.
NEXGENT_NOTIFICATION_SERVICE_TOKEN=
# API and workers must agree. Defaults to AX_CHAT_DEPLOYMENT when omitted.
# NEXGENT_NOTIFICATION_DEPLOYMENT=development
NEXGENT_NOTIFICATION_CONCURRENCY=4
NEXGENT_NOTIFICATION_MAX_ATTEMPTS=5
NEXGENT_NOTIFICATION_POLL_SECONDS=1
NEXGENT_SLACK_TIMEOUT_SECONDS=10
