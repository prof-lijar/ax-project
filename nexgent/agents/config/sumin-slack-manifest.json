{
  "display_information": {
    "name": "Sumin",
    "description": "Archive channel files to Nextcloud and find them by mentioning Sumin",
    "background_color": "#375E97"
  },
  "features": {
    "bot_user": {
      "display_name": "Sumin",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history",
        "files:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "file_shared",
        "message.channels",
        "message.groups",
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true
  }
}
