# Install outside the repository: /etc/nexgent/weekly-report-sync.env (mode 0600).
# Local role: SELECT + UPDATE outbox only. No local report-table writes needed.
WEEKLY_REPORT_SYNC_LOCAL_DSN=postgresql://sync_local:CHANGE_ME@LOCAL_DB_HOST:5432/LOCAL_DB
# The dedicated Docker network aliases PROD_DB_HOST to the tunnel.
# Preserve the DB certificate hostname and mount its trusted CA; TLS is end-to-end.
WEEKLY_REPORT_SYNC_TARGET_DSN=postgresql://sync_target:CHANGE_ME@PROD_DB_HOST:15432/PROD_DB?sslmode=verify-full&sslrootcert=/run/secrets/prod_db_ca.crt
WEEKLY_REPORT_SSH_HOST=BASTION_HOST
WEEKLY_REPORT_SSH_USER=report-forwarder
WEEKLY_REPORT_SSH_PORT=22
WEEKLY_REPORT_TARGET_HOST=PROD_DB_HOST
WEEKLY_REPORT_TARGET_PORT=5432
