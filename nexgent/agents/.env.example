# OpenAI-compatible model used by the `chat` graph. Never commit the real key.
URL=http://192.168.0.17:8000/v1
MODEL=gemma-4-31b
OPENAI_API_KEY=
# Enable only after the configured model passes a live image-input check.
OPENAI_SUPPORTS_VISION=false
# Shared transient attachment root when the product backend is in the topology.
AX_CHAT_ARTIFACT_ROOT=/run/ax-chat

# Read-only RAG search service used by the `rag_chat` graph. This URL must be
# reachable from the Agent Server runtime; do not include credentials in it.
RAG_SERVER_BASE_URL=
RAG_SEARCH_TIMEOUT_SECONDS=30

# MCP secrets are environment-backed and never stored in config/mcp_servers.json.
DB_MCP_SERVER_BEARER_TOKEN=
MCP_SERVERS_CONFIG=config/mcp_servers.json

# Private weekly-report source service.
ANSIMK_DATABASE_DSN=postgresql://readonly_user:replace-me@database:5432/ansimk
ANSIMK_DATABASE_MIN_POOL_SIZE=1
ANSIMK_DATABASE_MAX_POOL_SIZE=5
ANSIMK_DATABASE_CONNECT_TIMEOUT_SECONDS=10
ANSIMK_DATABASE_COMMAND_TIMEOUT_SECONDS=30
WEEKLY_REPORT_SOURCE_URL=http://weekly-report-api:8080
WEEKLY_REPORT_SOURCE_TIMEOUT_SECONDS=30
WEEKLY_REPORT_ITEM_TIMEOUT_SECONDS=60

# Bulk weekly-report jobs and temporary private ZIP exports.
WEEKLY_REPORT_JOB_DATABASE_DSN=postgresql://ax_bulk:replace-me@weekly-report-jobs-db:5432/ax_weekly_reports
WEEKLY_REPORT_ARTIFACT_ROOT=/var/lib/ax/weekly-reports
WEEKLY_REPORT_ARTIFACT_MIN_FREE_BYTES=10737418240
WEEKLY_REPORT_WORKER_CONCURRENCY=32
# Maximum bulk jobs admitted by one worker process. The item concurrency above
# remains the shared process-wide ceiling across all active jobs.
WEEKLY_REPORT_ACTIVE_JOB_LIMIT=4
WEEKLY_REPORT_WORKER_POLL_SECONDS=1
WEEKLY_REPORT_STATUS_POLL_SECONDS=2

# Fixed cron submission: every Monday at 04:00 Asia/Seoul. These settings
# control the submitted bulk request and bounded delivery retries, not cron.
WEEKLY_REPORT_BULK_API_URL=http://weekly-report-bulk-api:8090
WEEKLY_REPORT_SCHEDULE_MAX_REPORTS=10000
WEEKLY_REPORT_SCHEDULE_TIMEOUT_SECONDS=30
WEEKLY_REPORT_SCHEDULE_ATTEMPTS=3
WEEKLY_REPORT_SCHEDULE_RETRY_DELAY_SECONDS=2

# Agent-side notification clients use this file. The service token must match
# the backend notification API. Backend configuration remains backend-owned.
NEXGENT_SLACK_ENABLED=false
NEXGENT_NOTIFICATION_SERVICE_TOKEN=
NEXGENT_SLACK_CHANNELS={"default":"C0123456789","daily_risk":"C0C24T2124E"}
# Host-network daily scheduler; Compose sets the production published backend port.
DAILY_RISK_NOTIFICATION_BASE_URL=http://127.0.0.1:8001
# local, dev, prod, or both (dev then prod), after local reconciliation.
# Production Compose explicitly selects both; development defaults to local.
DAILY_RISK_SYNC_TARGET=local

# Dedicated writer used only by the bulk finalizer. This may point at the same
# database as the source DSN, but should use a role limited to the local
# archive.resources_ward_weekly_report table and its identity sequence.
# Production delivery uses its separate connection and ansimk schema.
WEEKLY_REPORT_STORAGE_DATABASE_DSN=postgresql://weekly_report_writer:replace-me@database:5432/ansimk
WEEKLY_REPORT_STORAGE_MIN_POOL_SIZE=1
WEEKLY_REPORT_STORAGE_MAX_POOL_SIZE=2
WEEKLY_REPORT_STORAGE_BATCH_SIZE=500
WEEKLY_REPORT_STORAGE_CONNECT_TIMEOUT_SECONDS=10
WEEKLY_REPORT_STORAGE_COMMAND_TIMEOUT_SECONDS=120

# Outbound-only Slack Web API. Never commit a real xoxb token.
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_DEFAULT_CHANNEL_ID=C0123456789
# Optional logical destinations; only configured channel IDs are approved.
SLACK_CHANNEL_OPERATIONS=C0123456789
SLACK_CHANNEL_REPORTS=C0234567890
SLACK_CHANNEL_ALERTS=C0345678901
SLACK_REQUEST_TIMEOUT_SECONDS=10

# Private, no-provider-key web metasearch used by reusable web tools.
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_SECRET=replace-with-a-random-service-secret

# OPENAI_BASE_URL and OPENAI_MODEL are supported as less ambiguous aliases.

# AX768 reuses URL/MODEL/OPENAI_API_KEY above. Leave sheet unset until provided.
AX768_SPREADSHEET=
# Exact tab gid for name search/highlight; never inferred from tab order.
AX768_NAME_SEARCH_SHEET_ID=
# Case 2.2 uses a separate spreadsheet and tab; it never edits the file.
AX768_CASE_2_2_SPREADSHEET=
AX768_CASE_2_2_SHEET_ID=
AX768_CASE_2_2_ADDRESS_COLUMNS=
# Case 2.3: AS Sheet, same-row name/address match, bottom-most row highlighting.
AX768_CASE_2_3_SPREADSHEET=
AX768_CASE_2_3_SHEET_ID=
AX768_CASE_2_3_NAME_COLUMN=I
AX768_CASE_2_3_ADDRESS_COLUMN=H
AX768_CASE_2_3_START_ROW=7
AX768_GOOGLE_AUTH_MODE=oauth
# Download a Desktop app OAuth client; login generates the private token file.
AX768_GOOGLE_OAUTH_CLIENT_FILE=
AX768_GOOGLE_OAUTH_TOKEN_FILE=
# Absolute path to a private service-account JSON file; share the sheet with its email.
AX768_GOOGLE_CREDENTIALS_FILE=

# Optional LangSmith tracing. The deterministic smoke graph does not need it.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false

# Optional production outbox sync still requires its production Compose overlay.
# Credentials live here; deployment switches remain explicit in the overlay.
WEEKLY_REPORT_DEPLOYMENT=development
WEEKLY_REPORT_SYNC_ENQUEUE=false

# Shared PostgreSQL connection for agents; reachable from their API/worker processes.
AGENT_DATABASE_DSN=

# Sumin (opt-in Slack -> Nextcloud agent; agents/.env is the runtime env file).
SUMIN_SLACK_BOT_TOKEN=
# App-level token with connections:write; enable Socket Mode in the Slack app.
SUMIN_SLACK_APP_TOKEN=
# Only needed if operating the optional HTTP ingress instead of Socket Mode.
SUMIN_SLACK_SIGNING_SECRET=
# HTTPS Nextcloud installation base, including any subpath; not a WebDAV URL.
SUMIN_NEXTCLOUD_URL=
SUMIN_NEXTCLOUD_USER=
# Nextcloud app password for the dedicated archive account.
SUMIN_NEXTCLOUD_PASSWORD=
# Optional PEM CA bundle for a privately issued Nextcloud certificate (host path).
SUMIN_NEXTCLOUD_CA_BUNDLE=
# Nextcloud certificate and hostname verification; Slack is unaffected.
SUMIN_NEXTCLOUD_VERIFY_SSL=true
SUMIN_NEXTCLOUD_ROOT=Slack
SUMIN_MAX_FILE_BYTES=26214400

# Manual and scheduled archive-to-production migration. The host below is the
# remote database endpoint; Python connects through the local SSH tunnel.
SOURCE_DATABASE_DSN=
LIVE_PROD_SSH_HOST=
LIVE_PROD_SSH_ID=root
LIVE_PROD_SSH_PASSWORD=
LIVE_PROD_DB_HOST=
LIVE_PROD_DB_PORT=5432
LIVE_PROD_DB_NAME=ansimk
LIVE_PROD_DB_USER=
LIVE_PROD_DB_PASSWORD=
LIVE_PROD_DB_SSL=require
LIVE_PROD_TUNNEL_PORT=15432

# Independent manual archive-to-development migration.
LIVE_DEV_SSH_HOST=
LIVE_DEV_SSH_ID=
LIVE_DEV_SSH_PASSWORD=
LIVE_DEV_SSH_PORT=22
LIVE_DEV_DB_HOST=
LIVE_DEV_DB_PORT=5432
LIVE_DEV_DB_NAME=ansimk
LIVE_DEV_DB_SCHEMA=ansimk
LIVE_DEV_DB_USER=
LIVE_DEV_DB_PASSWORD=
LIVE_DEV_DB_SSL=prefer

# Optional outbox-sync DSNs. Leave disabled unless deploying its overlay.
WEEKLY_REPORT_SYNC_LOCAL_DSN=
WEEKLY_REPORT_SYNC_TARGET_DSN=
# SSH keys/known_hosts/DB CA remain external files; set their paths here.
WEEKLY_REPORT_SSH_KEY_FILE=/etc/nexgent/weekly-report-sync-key
WEEKLY_REPORT_SSH_KNOWN_HOSTS_FILE=/etc/nexgent/weekly-report-sync-known-hosts
WEEKLY_REPORT_SYNC_CA_FILE=/etc/nexgent/weekly-report-prod-ca.crt

# Self-hosted runtime image/database configuration.
IMAGE_NAME=ax-agent-server:local
GATEWAY_IMAGE=ax-gateway:local
WEEKLY_REPORT_API_IMAGE=ax-weekly-report-api:local
WEEKLY_REPORT_WORKER_IMAGE=ax-weekly-report-worker:local
WEEKLY_REPORT_BULK_API_IMAGE=ax-weekly-report-bulk-api:local
POSTGRES_DB=ax_agents
POSTGRES_USER=ax_agents
POSTGRES_PASSWORD=change-me
LANGSMITH_API_KEY=
LANGGRAPH_CLOUD_LICENSE_KEY=

# IMEI Test case: private admin code/session paths, never paste secrets here.
# Local defaults: ~/.local/share/nexgent/{ansimk-admin-code,ansimk-api-session.json}
# The prior browser session can seed the API cache without another login.
# AX768_ANSIMK_CODE_FILE=/absolute/private/ansimk-admin-code
# AX768_ANSIMK_SESSION_FILE=/absolute/private/ansimk-api-session.json
# AX768_ANSIMK_SESSION_SEED_FILE=/absolute/private/ansimk-admin-session.json
