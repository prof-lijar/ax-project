{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexgent",
  "version": "0.1.0",
  "identifier": "ai.nextor.nexgent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexgent",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:5173 http://127.0.0.1:8000 ws://127.0.0.1:1421",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "frame-src": "'self' blob:",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [],
    "category": "Productivity",
    "shortDescription": "Agent workflow operator console",
    "longDescription": "Nexgent is a local desktop console for supervising tasks, agents, approvals, and activity."
  }
}
