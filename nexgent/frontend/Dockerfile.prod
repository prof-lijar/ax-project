# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS build

ARG VITE_BACKEND_PORT=8001
ARG VITE_RAG_SERVER_BASE_URL=http://192.168.0.18:8765
ARG VITE_SCOUT_API_BASE_URL=http://192.168.0.18:8091

ENV VITE_BACKEND_PORT=${VITE_BACKEND_PORT} \
    VITE_RAG_SERVER_BASE_URL=${VITE_RAG_SERVER_BASE_URL} \
    VITE_SCOUT_API_BASE_URL=${VITE_SCOUT_API_BASE_URL}

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
RUN npm run build

FROM nginx:stable-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
