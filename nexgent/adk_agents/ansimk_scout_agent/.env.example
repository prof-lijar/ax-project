# Isolated OpenAI-compatible model configuration for ansimk_scout_agent.
# Copy to .env and replace the placeholders. Never commit the real key.
OPENAI_API_BASE=http://127.0.0.1:8001/v1
OPENAI_API_KEY=
SCOUT_MODEL=openai/your-internal-model

# Runtime configuration
SCOUT_OUTPUT_ROOT=var
SCOUT_LOG_LEVEL=INFO
SCOUT_HOST=127.0.0.1
SCOUT_PORT=8091

# Optional post-research Slack delivery. Both blank disables delivery.
# Bot OAuth token (xoxb-...) requires chat:write; invite the bot to this channel.
SCOUT_SLACK_BOT_TOKEN=
SCOUT_SLACK_CHANNEL_ID=
